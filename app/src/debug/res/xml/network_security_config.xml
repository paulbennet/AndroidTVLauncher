<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: cleartext to 127.0.0.1 (adb reverse), for testing URL skin installs (SkinInstaller.testLoopback).
     Release builds have no network security config: cleartext stays blocked. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
